# =============================================================================
# Kairo — Mobile (Expo) · copy to .env
# =============================================================================
# Expo loads EXPO_PUBLIC_* at build time. Restart `npx expo start` after changes.
# API + Postgres + proof media (Supabase Storage on server) — see website/.env.example for DATABASE_URL, SUPABASE_*.
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk (required for sign-in / sign-up)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# -----------------------------------------------------------------------------
# API base URL (required) — no trailing slash
# -----------------------------------------------------------------------------
# iOS Simulator / same Mac:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_d2lsbGluZy1taWRnZS03MC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_stnlpdcaW97TM97qRjDfrJCXVG1cAt6MLdQtuRO5hf
# Physical phone (same Wi‑Fi as your Mac — use Next “Network” URL):
# EXPO_PUBLIC_API_URL=http://192.168.1.184:3000
# Android emulator → host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# -----------------------------------------------------------------------------
# Dev fallback Prisma User.id (optional — local only)
# -----------------------------------------------------------------------------
# Used as x-kairo-user-id when bootstrap + Clerk metadata are not set.
# After `npm run db:seed`, paste kairoUserIds.alice from the seed log, e.g.:
# EXPO_PUBLIC_KAIRO_DEV_USER_ID=clxxxxxxxxxxxxxxxxxxxxxxxx
