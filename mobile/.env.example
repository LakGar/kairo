# Next.js API origin (no trailing slash). Match “Local” vs “Network” from `next dev`:
# - iOS Simulator / same Mac: http://127.0.0.1:3000 or http://localhost:3000
# - Physical phone (same Wi‑Fi): http://<YOUR_LAN_IP>:3000 (e.g. http://192.168.1.184:3000 from Next’s “Network” line)
# - Android emulator: often http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# After sign-in, the app calls `POST /api/auth/bootstrap` on the website and stores the returned Prisma `User.id`
# in SecureStore for `x-kairo-user-id` (before Clerk metadata `kairoUserId` and before the dev id below).
#
# After `npm run db:seed`, copy `kairoUserIds.alice` from the seed log (organizer for seeded events).
# Sent as `x-kairo-user-id` when neither bootstrap nor Clerk metadata `kairoUserId` is set.
# EXPO_PUBLIC_KAIRO_DEV_USER_ID=

# In-app proof capture uploads via `POST /api/proof-media/upload-url` on the website; configure
# `PROOF_STORAGE_*` on the Next server (see `website/.env.example`). No extra keys are required in this file for uploads.
