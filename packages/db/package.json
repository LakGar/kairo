{
  "name": "@kairo/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -o -e ../../website/.env -e ../../website/.env.local -- prisma migrate dev",
    "push": "dotenv -o -e ../../website/.env -e ../../website/.env.local -- prisma db push",
    "push:accept-data-loss": "dotenv -o -e ../../website/.env -e ../../website/.env.local -- prisma db push --accept-data-loss",
    "push:reset": "dotenv -o -e ../../website/.env -e ../../website/.env.local -- prisma db push --force-reset",
    "studio": "dotenv -o -e ../../website/.env -e ../../website/.env.local -- prisma studio",
    "seed": "dotenv -o -e ../../website/.env -e ../../website/.env.local -- prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
