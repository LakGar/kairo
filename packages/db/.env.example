# =============================================================================
# Kairo — @kairo/db (Prisma) · optional standalone copy
# =============================================================================
# Root scripts npm run db:push / db:seed / … load website/.env then website/.env.local
# (see packages/db/package.json). Prefer putting DATABASE_URL there.
#
# Use this file only if you run prisma directly from packages/db without those paths.
#
# Supabase Postgres: use the full connection string from the Supabase dashboard
# (Database → connection string / pooler). Proof media uses separate SUPABASE_* on website — see website/.env.example.
# =============================================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kairo
