# =============================================================================
# Kairo — Website (Next.js) · copy to .env / .env.local
# =============================================================================
# Prisma CLI (db:push, seed, …) loads this file then .env.local — see packages/db/package.json.
# Full staging + Supabase checklist: docs/staging-setup.md
# =============================================================================

# --- Postgres (Prisma) — required for API + migrations ---
# Local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kairo
# Supabase-hosted DB (example shape — use your project’s string from Dashboard → Connect):
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase project URL (same host for Storage API + optional client tooling) ---
# Dashboard → Project Settings → API → "Project URL" (https://<ref>.supabase.co).
# Proof uploads read SUPABASE_URL first, then NEXT_PUBLIC_SUPABASE_URL if unset (server only).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=

# --- Supabase Storage — proof media signed PUT (server only; never expose to Expo) ---
# Dashboard → Project Settings → API → "service_role" secret (not anon key).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROOF_BUCKET=kairo-proof-media
# Optional: replace origin of public object URLs (CDN / custom domain).
SUPABASE_PROOF_PUBLIC_BASE_URL=

# --- Optional ---
STRIPE_SECRET_KEY=
# Local dev only (non-production): allow file:// proof URLs when set to 1
PROOF_ALLOW_FILE_URL=
