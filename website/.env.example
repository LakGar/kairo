# PostgreSQL for Prisma (`@kairo/db`). Copy to `.env` or `.env.local`.
# Root scripts `npm run db:push`, `db:seed`, etc. load this file and `.env.local` from here
# (see `packages/db/package.json` — `dotenv-cli`) so you do not need a separate `packages/db/.env`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kairo"

# `POST /api/auth/bootstrap` (mobile) upserts `User` + `Profile` using JSON from the client.
# TODO(production): verify Clerk session server-side; do not expose this endpoint publicly without auth.

# Stripe (optional) — billing portal + purchase list for mobile `settings/payments`.
# STRIPE_SECRET_KEY=sk_test_...

# --- Proof media (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.) ---
# Mobile requests `POST /api/proof-media/upload-url`, uploads bytes with presigned PUT, then submits proof with `publicUrl`.
# If unset, the route returns 503 NOT_CONFIGURED until you configure storage.
# PROOF_STORAGE_BUCKET=
# PROOF_STORAGE_REGION=us-east-1
# For R2 or MinIO, set endpoint and often region `auto` (see your provider docs):
# PROOF_STORAGE_ENDPOINT=
# PROOF_STORAGE_ACCESS_KEY_ID=
# PROOF_STORAGE_SECRET_ACCESS_KEY=
# Public HTTPS base for objects (no trailing slash). Example: https://pub-xxxxx.r2.dev or https://cdn.example.com
# PROOF_STORAGE_PUBLIC_BASE_URL=
# Optional: allow `file:` URLs on PHOTO/VIDEO proof submit (local dev only; never enable in production).
# PROOF_ALLOW_FILE_URL=

# --- Prisma / local Postgres ---
# `npm run db:push` loads this file + `.env.local` (see `packages/db/package.json`).
# If `db:push` fails (e.g. "cannot add required column email" on old rows), use a new
# database URL or wipe this dev DB, then apply schema + seed in one step:
#   npm run db:dev:fresh
# (destructive: `prisma db push --force-reset` then `db:seed` — never on production.)
